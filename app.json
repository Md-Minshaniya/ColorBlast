{
  "expo": {
    "name": "Color Blast",
    "slug": "color-blast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.minish4279niya.colorblast",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17002D"
      },
      "permissions": []
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/transparent-splash.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#17002D"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "26d4d03f-ad02-46f6-a769-3b2d493c776e"
      }
    }
  }
}